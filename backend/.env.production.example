NODE_ENV=production
# AI quota defaults; counters persist in PostgreSQL (migration 003).
AI_REQUESTS_PER_MINUTE=12
AI_REQUESTS_PER_DAY=100
AI_GLOBAL_REQUESTS_PER_DAY=1000
FRONTEND_URL=https://bu-kanji.vercel.app
CORS_ORIGIN=https://bu-kanji.vercel.app
# Keep host-only cookies when the browser reaches Render through Vercel /api.
COOKIE_DOMAIN=
COOKIE_SECURE=true

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL=true
# Default true for external providers. Render private self-signed TLS uses false.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Bu Kanji <auth@example.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://bu-kanji.vercel.app/api/auth/google/callback
