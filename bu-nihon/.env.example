# Local: browser -> Next.js /api -> NestJS on localhost:3001
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=http://localhost:3001

# Server only. Put the real key directly in .env.local, never in NEXT_PUBLIC_*.
CHATMOCK_BASE_URL=https://chatmock.vothanhan.dev/v1
CHATMOCK_GATEWAY_SECRET=<your-chatmock-gateway-secret>
